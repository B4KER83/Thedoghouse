/* ---------- availability rules ---------- */
function inDayOff(k) { return D.avail.daysOff.some(function (o) { return k >= o.from && k <= o.to; }); }
function openHours(k) {
  if (inDayOff(k)) return [];
  if (D.avail.overrides[k]) return D.avail.overrides[k];
  return D.avail.template[pkey(k).getDay()] || [];
}
function load(k, h, excl) {
  return D.bookings.filter(function (b) {
    return b.id !== excl && b.date === k && (b.status === 'pending' || b.status === 'approved') && h >= b.start && h < b.start + b.hours;
  }).length;
}
function free(k, h, excl) { return openHours(k).indexOf(h) >= 0 && load(k, h, excl) < D.settings.perSlot; }
function lastBookable() { return addDays(today(), D.settings.weeksAhead * 7); }
function tooSoon(k, h) { var d = pkey(k); d.setHours(h); return d.getTime() < Date.now() + D.settings.noticeHrs * 3600000; }
function canStart(k, s, dur, excl, staff) {
  if (!staff) {
    if (pkey(k) > lastBookable() || tooSoon(k, s)) return false;
  }
  for (var h = s; h < s + dur; h++) if (!free(k, h, excl)) return false;
  return true;
}
function starts(k, dur, excl, staff) {
  var r = [];
  for (var h = 5; h <= 22; h++) if (canStart(k, h, dur, excl, staff)) r.push(h);
  return r;
}
function fits(b) { return canStart(b.date, b.start, b.hours, b.id, true); }
function dayStatus(k, dur) {
  var d = pkey(k);
  if (d < today() || d > lastBookable()) return 'past';
  if (!openHours(k).length) return 'closed';
  var n = starts(k, dur, null, false).length;
  return n === 0 ? 'full' : n <= 2 ? 'few' : 'free';
}
function activeSvcs() { return D.services.filter(function (s) { return s.active; }); }
function svcByName(n) { return D.services.filter(function (s) { return s.name === n; })[0] || null; }
function money(p) { return p == null || p === '' || isNaN(p) ? '' : '£' + (+p).toFixed(2).replace(/\.00$/, ''); }
function defaultSvc(name) { var a = activeSvcs(), s = svcByName(name); return s && s.active ? s.name : (a[0] ? a[0].name : ''); }
function lenApproved(d) { return !!(d && d.approvedHours); }
function pendingDogs() { return D.dogs.filter(function (d) { return !d.approvedHours; }); }
