function userByEmail(e) {
  e = String(e || '').trim().toLowerCase();
  return D.users.filter(function (u) { return u.email === e; })[0] || null;
}
var API = {
  login: function (email, pw) {
    var u = userByEmail(email);
    if (!u || u.password !== pw) return { error: 'That email and password don’t match.' };
    if (u.status === 'suspended') return { error: 'This account is suspended. Please contact the salon.' };
    return { user: u };
  },
  signup: function (f) {
    if (!f.name || !f.email || !f.password) return { error: 'Please fill in your name, email and password.' };
    if (!/^\S+@\S+\.\S+$/.test(f.email)) return { error: 'Please enter a valid email address.' };
    if (f.password.length < 6) return { error: 'Your password needs at least 6 characters.' };
    if (f.password !== f.confirm) return { error: 'The two passwords don’t match.' };
    if (!f.agree) return { error: 'Please agree to the booking policy.' };
    if (userByEmail(f.email)) return { error: 'An account with that email already exists — try signing in.' };
    var u = { id: 'u_' + uid(), email: f.email.trim().toLowerCase(), password: f.password, name: f.name.trim(), phone: f.phone.trim(), role: 'customer', status: 'active', created: tkey() };
    D.users.push(u);
    if (!persist()) return { error: 'Could not save your account.' };
    return { user: u };
  },
  saveDog: function (userId, dr) {
    var dog = dr.id ? byId(D.dogs, dr.id) : null;
    if (!dog) { dog = { id: 'd_' + uid(), userId: userId }; D.dogs.push(dog); }
    var changed = dog.hours !== dr.hours;
    ['name', 'breed', 'age', 'size', 'service', 'hours', 'notes', 'photo', 'refs'].forEach(function (k) { dog[k] = dr[k]; });
    if (changed || dog.approvedHours === undefined) dog.approvedHours = null;
    return persist() ? { dog: dog } : { error: 'save' };
  },
  approveLength: function (id, h) { var d = byId(D.dogs, id); if (!d) return; d.approvedHours = h; d.hours = h; persist(); },
  deleteDog: function (id) {
    D.dogs = D.dogs.filter(function (d) { return d.id !== id; });
    D.bookings.forEach(function (b) {
      if (b.dogId === id && b.date >= tkey() && (b.status === 'pending' || b.status === 'approved')) b.status = 'cancelled';
    });
    persist();
  },
  requestBooking: function (r) {
    if (!r.date || r.start == null) return { error: 'Please choose a day and a start time.' };
    var dg = byId(D.dogs, r.dogId);
    if (!lenApproved(dg) || dg.approvedHours !== r.hours) return { error: 'The salon needs to approve ' + (dg ? dg.name : 'your dog') + '’s appointment length first.' };
    var sv = svcByName(r.service);
    if (!sv || !sv.active) return { error: 'Please choose a service.' };
    if (!canStart(r.date, r.start, r.hours, null, false)) return { error: 'Sorry — that time has just gone. Please pick another.' };
    var b = { id: 'b_' + uid(), userId: r.userId, dogId: r.dogId, date: r.date, start: r.start, hours: r.hours, service: r.service, quote: sv.price, price: null, status: 'pending', note: '', created: new Date().toISOString() };
    D.bookings.push(b);
    return persist() ? { booking: b } : { error: 'Could not save the request.' };
  },
  approve: function (id, price) { var b = byId(D.bookings, id); if (!b) return; b.status = 'approved'; b.price = price; persist(); },
  setPrice: function (id, price) { var b = byId(D.bookings, id); if (!b) return; b.price = price; persist(); },
  saveServices: function (list) { D.services = list; persist(); },
  setStatus: function (id, status, note) {
    var b = byId(D.bookings, id); if (!b) return;
    b.status = status; if (note != null) b.note = note;
    persist();
  },
  updateTime: function (id, date, start, hours) {
    var b = byId(D.bookings, id); if (!b) return { error: 'Booking not found.' };
    if (!canStart(date, start, hours, id, true)) return { error: 'That time isn’t free.' };
    b.date = date; b.start = start; b.hours = hours;
    persist(); return { booking: b };
  },
  updateUser: function (id, f) {
    var u = byId(D.users, id); if (!u) return { error: 'Not found.' };
    if (f.email != null) {
      var e = f.email.trim().toLowerCase();
      if (!/^\S+@\S+\.\S+$/.test(e)) return { error: 'Please enter a valid email address.' };
      var other = userByEmail(e);
      if (other && other.id !== id) return { error: 'Another account already uses that email.' };
      u.email = e;
    }
    if (f.name != null) u.name = f.name.trim() || u.name;
    if (f.phone != null) u.phone = f.phone.trim();
    if (f.status) u.status = f.status;
    if (f.password) u.password = f.password;
    persist(); return { user: u };
  },
  deleteUser: function (id) {
    var dogIds = D.dogs.filter(function (d) { return d.userId === id; }).map(function (d) { return d.id; });
    D.users = D.users.filter(function (u) { return u.id !== id; });
    D.dogs = D.dogs.filter(function (d) { return dogIds.indexOf(d.id) < 0; });
    D.bookings = D.bookings.filter(function (b) { return b.userId !== id; });
    persist();
  },
  saveTemplate: function (t) { D.avail.template = t; persist(); },
  saveRules: function (r) { D.settings = r; persist(); },
  toggleHour: function (k, h) {
    var cur = openHours(k).slice(), i = cur.indexOf(h);
    if (i >= 0) cur.splice(i, 1); else cur.push(h);
    cur.sort(function (a, b) { return a - b; });
    D.avail.overrides[k] = cur; persist();
  },
  resetDay: function (k) { delete D.avail.overrides[k]; persist(); },
  addDayOff: function (o) { D.avail.daysOff.push(o); D.avail.daysOff.sort(function (a, b) { return a.from < b.from ? -1 : 1; }); persist(); },
  removeDayOff: function (i) { D.avail.daysOff.splice(i, 1); persist(); }
};

