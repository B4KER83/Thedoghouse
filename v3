  setSession(r.user); S = { view: 'requests' }; render();
};
ACT.signup = function () {
  var r = API.signup({ name: val('sName'), email: val('sEmail'), phone: val('sPhone'), password: val('sPw'), confirm: val('sPw2'), agree: $('#sAgree').checked });
  if (r.error) { $('#sErr').textContent = r.error; return; }
  setSession(r.user); S = { view: 'dogEdit', onboard: true, firstBook: true };
  S.draft = { name: '', breed: '', age: '', size: 'Medium', service: defaultSvc(''), hours: 2, notes: '', photo: '', refs: [] };
  render();
};
ACT.forgot = function () {
  $('#fMsg').innerHTML = '<div class="info">' + IC.info + '<span>In the live version a reset link would be emailed. For this demo, ask the salon to set a new password for you from their Accounts page.</span></div>';
};

ACT.pickDog = function (el) { var d = byId(D.dogs, el.getAttribute('data-id')); S.book.dogId = d.id; S.book.dur = d.approvedHours || d.hours || 1; S.book.service = defaultSvc(d.service); S.book.start = null; render(); };
ACT.month = function (el) { var m = S.book.month; S.book.month = new Date(m.getFullYear(), m.getMonth() + (+el.getAttribute('data-d')), 1); render(); };
ACT.pickDay = function (el) { S.book.day = el.getAttribute('data-k'); S.book.start = null; render(); };
ACT.pickSlot = function (el) { S.book.start = +el.getAttribute('data-h'); render(); };
ACT.request = function () {
  var b = S.book, u = me();
  var r = API.requestBooking({ userId: u.id, dogId: b.dogId, date: b.day, start: b.start, hours: b.dur, service: b.service });
  if (r.error) { toast(r.error); b.start = null; render(); return; }
  S.lastId = r.booking.id; b.day = null; b.start = null; S.firstBook = false;
  go('requested');
};
ACT.bt = function (el) { S.bt = el.getAttribute('data-v'); render(); };
ACT.cancelMine = function (el) {
  if (!confirm('Cancel this booking?')) return;
  API.setStatus(el.getAttribute('data-id'), 'cancelled'); render(); toast('Booking cancelled.');
};

ACT.newDog = function () { S.draft = { name: '', breed: '', age: '', size: 'Medium', service: defaultSvc(''), hours: 2, notes: '', photo: '', refs: [] }; go('dogEdit'); };
ACT.editDog = function (el) { var d = byId(D.dogs, el.getAttribute('data-id')); S.draft = JSON.parse(JSON.stringify(d)); go('dogEdit'); };
ACT.draftChip = function (el) {
  var k = el.getAttribute('data-k'), v = el.getAttribute('data-v');
  S.draft[k] = k === 'hours' ? +v : v;
  [].forEach.call(el.parentNode.children, function (c) { c.classList.remove('on'); });
  el.classList.add('on');
};
ACT.rmRef = function (el) { S.draft.refs.splice(+el.getAttribute('data-i'), 1); $('#dRefs').innerHTML = refsHtml(); };
ACT.saveDog = function () {
  var d = S.draft;
  d.name = val('dName').trim(); d.breed = val('dBreed').trim(); d.age = val('dAge').trim(); d.service = val('dService'); d.notes = val('dNotes').trim();
  if (!d.name) { $('#dErr').textContent = 'Please add your dog’s name.'; return; }
  var r = API.saveDog(me().id, d);
  if (r.error) return;
  S.book = null;
  var waiting = !r.dog.approvedHours;
  if (S.onboard) { S.onboard = false; S.book = null; go('book'); }
  else go('dogs');
  toast(waiting ? d.name + ' saved — the salon will confirm the appointment length.' : d.name + ' saved.');
};
ACT.deleteDog = function () {
  if (!confirm('Remove ' + S.draft.name + '? Any upcoming bookings for them will be cancelled.')) return;
  API.deleteDog(S.draft.id); S.book = null; go('dogs');
};
ACT.saveMe = function () { API.updateUser(me().id, { name: val('mName'), phone: val('mPhone') }); render(); toast('Details saved.'); };
ACT.changePw = function () {
  var u = me();
  if (val('mOld') !== u.password) { $('#mErr').textContent = 'Your current password isn’t right.'; return; }
  if (val('mNew').length < 6) { $('#mErr').textContent = 'New password needs at least 6 characters.'; return; }
  API.updateUser(u.id, { password: val('mNew') }); render(); toast('Password updated.');
};

function ownerOf(id) { var b = byId(D.bookings, id); return (b && byId(D.users, b.userId)) || { name: 'The customer' }; }
ACT.approveLen = function (el) {
  var id = el.getAttribute('data-id'), d = byId(D.dogs, id), h = +val('len_' + id), u = byId(D.users, d.userId) || { name: 'The customer' };
  API.approveLength(id, h); render(); toast(d.name + ' approved at ' + h + ' hr — ' + u.name + ' can now book (email would be sent).');
};
ACT.rf = function (el) { S.rf = el.getAttribute('data-v'); render(); };
ACT.approve = function (el) {
  var id = el.getAttribute('data-id'), b = byId(D.bookings, id);
  if (!fits(b)) { toast('This clashes with another booking or closed hours — change the time first.'); return; }
  openPriceModal(id, true);
};
function openPriceModal(id, approving) {
  var b = byId(D.bookings, id), dog = byId(D.dogs, b.dogId) || { name: '' }, sv = svcByName(b.service);
  var start = b.price != null ? b.price : (b.quote != null ? b.quote : (sv ? sv.price : ''));
  openModal('<h2>' + (approving ? 'Approve ' : 'Price for ') + esc(dog.name) + '’s booking</h2><p class="small muted">' + span(b) + ' · ' + esc(b.service) + ' · ' + b.hours + ' hr</p>' +
    (sv ? '<div class="note">Price list for ' + esc(sv.name) + ': <b>' + money(sv.price) + '</b></div>' : '') +
    '<label class="field">Price for this appointment (£)<input id="apPrice" type="number" inputmode="decimal" min="0" step="0.50" value="' + esc(start) + '"></label>' +
    '<div class="err" id="apErr"></div>' +
    '<div class="row wrap" style="justify-content:flex-end"><button class="btn btn-o btn-sm" data-act="closeModalBtn">Cancel</button><button class="btn ' + (approving ? 'btn-g' : 'btn-p') + ' btn-sm" data-act="doApprove" data-id="' + id + '" data-ap="' + (approving ? 1 : 0) + '">' + (approving ? IC.check + 'Approve booking' : 'Save price') + '</button></div>');
  setTimeout(function () { var i = $('#apPrice'); if (i) i.focus(); }, 50);
}
ACT.editPrice = function (el) { openPriceModal(el.getAttribute('data-id'), false); };
ACT.doApprove = function (el) {
  var id = el.getAttribute('data-id'), ap = el.getAttribute('data-ap') === '1', raw = val('apPrice');
  var p = Math.round(parseFloat(raw) * 100) / 100;
  if (raw === '' || isNaN(p) || p < 0) { $('#apErr').textContent = 'Please enter the price in pounds.'; return; }
  if (ap) API.approve(id, p); else API.setPrice(id, p);
  closeModal(); render();
  toast((ap ? 'Approved at ' : 'Price updated to ') + money(p) + ' — ' + ownerOf(id).name + ' would be emailed.');
};
ACT.decline = function (el) {
  var id = el.getAttribute('data-id');
  openModal('<h2>Decline this request?</h2><p class="small muted">' + span(byId(D.bookings, id)) + '</p><label class="field">Message to the customer (optional)<textarea id="dnNote" placeholder="e.g. Fully booked that afternoon — could you do Friday?"></textarea></label>' +
    '<div class="row wrap" style="justify-content:flex-end"><button class="btn btn-o btn-sm" data-act="closeModalBtn">Keep it</button><button class="btn btn-d btn-sm" data-act="doDecline" data-id="' + id + '">Decline request</button></div>');
};
ACT.doDecline = function (el) { var id = el.getAttribute('data-id'); API.setStatus(id, 'declined', val('dnNote').trim()); closeModal(); render(); toast('Declined — ' + ownerOf(id).name + ' would be emailed.'); };
ACT.adminCancel = function (el) {
  var id = el.getAttribute('data-id');
  if (!confirm('Cancel this approved booking? The customer would be emailed.')) return;
  API.setStatus(id, 'cancelled'); render(); toast('Booking cancelled.');
};
ACT.reopen = function (el) {
  var id = el.getAttribute('data-id'), b = byId(D.bookings, id);
  if (!fits(b)) { toast('That time is no longer free — use Change time after reopening.'); }
  API.setStatus(id, 'pending'); render();
};
ACT.changeTime = function (el) {
  var b = byId(D.bookings, el.getAttribute('data-id'));
  S.mt = { id: b.id, date: b.date, dur: b.hours, start: b.start };
  openModal(mtHtml());
};
ACT.mtSave = function (el) {
  var m = S.mt, ap = el.getAttribute('data-ap') === '1';
  var r = API.updateTime(m.id, m.date, m.start, m.dur);
  if (r.error) { toast(r.error); return; }
  var who = ownerOf(m.id).name, id = m.id;
  closeModal(); render();
  if (ap) openPriceModal(id, true); else toast('Time updated — ' + who + ' would be emailed.');
};

ACT.wk = function (el) { var d = +el.getAttribute('data-d'); S.wk = d === 0 ? 0 : (S.wk || 0) + d; render(); };
ACT.toggleHour = function (el) { API.toggleHour(el.getAttribute('data-k'), +el.getAttribute('data-h')); render(); };
ACT.resetDay = function (el) { API.resetDay(el.getAttribute('data-k')); render(); };
ACT.saveTemplate = function () {
  var t = {};
  for (var d = 0; d < 7; d++) {
    var a = +val('tFrom' + d), b = +val('tTo' + d);
    t[d] = $('#tOpen' + d).checked && b > a ? hrs(a, b) : [];
  }
  API.saveTemplate(t); render(); toast('Opening hours saved.');
};
ACT.addOff = function () {
  var f = val('oFrom'), to = val('oTo') || f;
  if (!f) { toast('Pick a start date.'); return; }
  if (to < f) { var x = f; f = to; to = x; }
  API.addDayOff({ from: f, to: to, label: val('oLbl').trim() });
  var hit = D.bookings.filter(function (b) { return b.date >= f && b.date <= to && (b.status === 'pending' || b.status === 'approved'); }).length;
  render(); toast(hit ? 'Days off added — ' + hit + ' booking' + (hit > 1 ? 's' : '') + ' fall in that period. Check Requests.' : 'Days off added.');
};
ACT.rmOff = function (el) { API.removeDayOff(+el.getAttribute('data-i')); render(); };

function readSvcs() {
  var out = [], err = '';
  D.services.forEach(function (s, i) {
    var n = val('svN' + i).trim(), p = parseFloat(val('svP' + i));
    if (!n) err = 'Every service needs a name.';
    if (isNaN(p) || p < 0) err = 'Please enter a price for ' + (n || 'each service') + '.';
    out.push({ id: s.id, name: n, price: Math.round(p * 100) / 100, active: $('#svA' + i).checked });
  });
  return { list: out, error: err };
}
ACT.saveSvcs = function () {
  var r = readSvcs();
  if (r.error) { $('#svErr').textContent = r.error; return; }
  if (!r.list.some(function (s) { return s.active; })) { $('#svErr').textContent = 'Keep at least one service offered so customers can book.'; return; }
  API.saveServices(r.list); S.book = null; render(); toast('Services saved.');
};
ACT.addSvc = function () {
  var n = val('svNewN').trim(), p = parseFloat(val('svNewP'));
  if (!n || isNaN(p) || p < 0) { toast('Enter a name and a price.'); return; }
  var r = readSvcs(); if (r.error) { $('#svErr').textContent = r.error; return; }
  r.list.push({ id: 's_' + uid(), name: n, price: Math.round(p * 100) / 100, active: true });
  API.saveServices(r.list); render(); toast(n + ' added at ' + money(p) + '.');
};
ACT.rmSvc = function (el) {
  var i = +el.getAttribute('data-i'), s = D.services[i];
  if (!confirm('Remove ' + s.name + '? Existing bookings keep their service name.')) return;
  D.services.splice(i, 1); API.saveServices(D.services); render();
};
ACT.pickAcct = function (el) { S.acct = el.getAttribute('data-id'); render(); };
ACT.saveAcct = function () {
  var r = API.updateUser(S.acct, { name: val('xName'), email: val('xEmail'), phone: val('xPhone') });
  if (r.error) { $('#xErr').textContent = r.error; return; }
  render(); toast('Customer details saved.');
};
ACT.setPw = function () {
  var p = val('xPw');
  if (p.length < 4) { toast('Use at least 4 characters.'); return; }
  API.updateUser(S.acct, { password: p }); render(); toast('Password changed — let the customer know.');
};
ACT.suspend = function () {
  var u = byId(D.users, S.acct), sus = u.status !== 'suspended';
  if (sus && !confirm('Suspend ' + u.name + '? They won’t be able to sign in.')) return;
  API.updateUser(u.id, { status: sus ? 'suspended' : 'active' }); render(); toast(sus ? 'Account suspended.' : 'Account reactivated.');
};
ACT.delAcct = function () {
  var u = byId(D.users, S.acct);
  if (!confirm('Permanently delete ' + u.name + ', their dogs and all their bookings?')) return;
  API.deleteUser(u.id); S.acct = null; render(); toast('Account deleted.');
};

/* change handlers */
var CH = {};
CH.bookService = function (el) { S.book.service = el.value; };
CH.dogPhoto = function (el) {
  readImg(el.files[0], 600, function (url) {
    S.draft.photo = url;
    var old = $('#dPhoto'), img = document.createElement('img');
    img.id = 'dPhoto'; img.className = 'photo'; img.src = url; img.alt = '';
    old.parentNode.replaceChild(img, old);
    $('#dPhotoLbl').textContent = 'Change photo';
  });
  el.value = '';
};
CH.dogRef = function (el) {
  readImg(el.files[0], 500, function (url) { S.draft.refs = (S.draft.refs || []).concat(url).slice(0, 3); $('#dRefs').innerHTML = refsHtml(); });
  el.value = '';
};
CH.mtDate = function (el) { if (el.value) { S.mt.date = el.value; openModal(mtHtml()); } };
CH.mtDur = function (el) { S.mt.dur = +el.value; openModal(mtHtml()); };
CH.mtStart = function (el) { S.mt.start = +el.value; };
CH.saveRules = function () {
  API.saveRules({ perSlot: +val('rPer'), weeksAhead: +val('rWeeks'), noticeHrs: +val('rNotice') });
  render(); toast('Booking rules saved.');
};
var IN = {};
IN.search = function (el) { S.q = el.value; $('#acctList').innerHTML = acctRows(); };

/* event wiring */
document.addEventListener('click', function (e) {
  var el = e.target.closest('[data-act]');
  if (!el) return;
  var fn = ACT[el.getAttribute('data-act')];
  if (!fn) return;
  if (el.tagName === 'A') e.preventDefault();
  fn(el, e);
});
document.addEventListener('change', function (e) {
  var el = e.target.closest('[data-change]');
  if (el && CH[el.getAttribute('data-change')]) CH[el.getAttribute('data-change')](el);
});
document.addEventListener('input', function (e) {
  var el = e.target.closest('[data-input]');
  if (el && IN[el.getAttribute('data-input')]) IN[el.getAttribute('data-input')](el);
});
document.addEventListener('submit', function (e) {
  var f = e.target, fn = ACT[f.getAttribute('data-submit')];
  e.preventDefault();
  if (fn) fn(f);
});
document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('#modal').hidden) closeModal(); });

render();
})();
</script>
</body>
</html>
