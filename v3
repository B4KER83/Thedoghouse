<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Dog House · Book a groom</title>
<meta name="description" content="Book a grooming appointment at The Dog House Grooming Salon.">
<meta name="theme-color" content="#2C4A6E">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Dog House">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Delius&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--navy:#2C4A6E;--navy-d:#1F3550;--ink:#1E2A38;--muted:#5B6B7C;--line:#DCE7F1;--line2:#C9D6E3;--bub:#EEF5FB;--bub2:#B9D9EF;--fur:#8A4A2C;--bg:#F4F7FA;--ok:#2F7A4F;--okbg:#E2F3E8;--okt:#1F6B40;--wait:#D98A1E;--waitbg:#FDF1DD;--waitt:#8A5300;--bad:#9B2C22;--badbg:#FBE5E3}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:'Nunito',system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--bg);-webkit-text-size-adjust:100%;line-height:1.35}
h1,h2{font-family:'Delius',cursive;font-weight:400;color:var(--navy);margin:0}
h1{font-size:28px}h2{font-size:20px}
p{margin:0}
a{color:var(--navy);font-weight:700}
button{font-family:inherit}
img{display:block}
#demo{background:var(--waitbg);color:#6B4100;font-size:13px;font-weight:700;padding:7px 16px;display:flex;gap:10px;align-items:center;justify-content:center;flex-wrap:wrap;text-align:center}
#demo button{border:1px solid #D9B57A;background:#fff;color:#6B4100;border-radius:14px;padding:4px 10px;font-size:12px;font-weight:800;cursor:pointer}
.phone{max-width:480px;margin:0 auto;background:#fff;min-height:calc(100vh - 34px);display:flex;flex-direction:column}
@media(min-width:768px){.phone{margin:24px auto;min-height:0;border-radius:24px;box-shadow:0 10px 40px rgba(31,53,80,.12);overflow:hidden}}
.pad{padding:20px 20px 28px;display:flex;flex-direction:column;gap:18px;flex:1}
.stack{display:flex;flex-direction:column;gap:14px}
.tight{gap:6px}
.row{display:flex;gap:10px;align-items:center}
.wrap{flex-wrap:wrap}
.between{justify-content:space-between}
.grow{flex:1}
.muted{color:var(--muted)}
.small{font-size:13px}
.center{text-align:center}
.right{text-align:right}
.field{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:700}
.field input,.field select,.field textarea,.inp{height:48px;border:1.5px solid var(--line2);border-radius:12px;padding:0 14px;font:inherit;font-weight:400;font-size:16px;color:var(--ink);background:#fff;width:100%;min-width:0}
.field textarea{height:96px;padding:12px 14px;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus,.inp:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(44,74,110,.15)}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.check{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#3D4C5C}
.check input{width:20px;height:20px;margin:0;accent-color:var(--navy);flex-shrink:0}
.btn{min-height:48px;padding:0 20px;border-radius:24px;font-weight:800;font-size:15px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;text-decoration:none;text-align:center}
.btn-p{background:var(--navy);color:#fff}.btn-p:hover{background:var(--navy-d)}
.btn-p:disabled{background:#AFC0D1;cursor:not-allowed}
.btn-o{background:#fff;color:var(--navy);border:1.5px solid var(--navy)}
.btn-g{background:var(--ok);color:#fff}
.btn-d{background:#fff;color:var(--bad);border:1.5px solid #E3B4AF}
.btn-sm{min-height:40px;padding:0 14px;font-size:14px}
.btn-block{width:100%}
.big{min-height:54px;font-size:16px;border-radius:28px}
.link{background:none;border:0;padding:8px;color:var(--navy);font-weight:800;font-size:15px;cursor:pointer}
.card{background:#fff;border:1px solid #E1E9F1;border-radius:18px;padding:16px}
.soft{background:var(--bub);border-radius:16px;padding:16px}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:800;white-space:nowrap}
.p-pending{background:var(--waitbg);color:var(--waitt)}
.p-approved{background:var(--okbg);color:var(--okt)}
.p-declined,.p-suspended,.p-clash{background:var(--badbg);color:var(--bad)}
.p-cancelled,.p-completed{background:#EEF2F6;color:#4A5A6B}
.p-new{background:#E3EEFA;color:#1F4E86}
.p-active{background:var(--okbg);color:var(--okt)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{flex:1 1 0;min-height:46px;min-width:60px;border-radius:12px;border:1.5px solid var(--bub2);background:#fff;color:var(--navy);font-weight:700;font-size:15px;cursor:pointer;padding:0 10px}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:800}
.dogchip{display:flex;align-items:center;gap:8px;padding:4px 16px 4px 4px;border-radius:26px;border:1.5px solid var(--bub2);background:#fff;font-weight:800;font-size:15px;color:var(--navy);cursor:pointer;min-height:50px}
.dogchip.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.av{width:40px;height:40px;border-radius:50%;object-fit:cover;background:var(--bub);flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-weight:800;color:var(--navy);font-size:15px;overflow:hidden}
.av.lg{width:56px;height:56px;font-size:20px}
.sec{font-weight:800;font-size:15px}
.step{font-size:12px;font-weight:800;letter-spacing:2px;color:var(--fur)}
.bar{display:flex;gap:6px}.bar i{flex:1;height:6px;border-radius:3px;background:var(--line)}.bar i.on{background:var(--navy)}
.calbox{border:1.5px solid var(--line);border-radius:18px;padding:12px;display:flex;flex-direction:column;gap:8px}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
.dow{text-align:center;font-size:12px;font-weight:800;color:var(--muted)}
.day{height:46px;border:0;border-radius:12px;background:#fff;font-size:15px;font-weight:700;color:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;padding:0}
.day i{width:5px;height:5px;border-radius:3px;background:transparent}
.day.free i{background:#2F8A57}.day.few i{background:var(--wait)}
.day.off{color:#A9B4BF;font-weight:600;cursor:default}
.day.closed span,.day.full span{text-decoration:line-through}
.day.today{box-shadow:inset 0 0 0 1.5px var(--bub2)}
.day.sel{background:var(--navy);color:#fff}.day.sel i{background:#fff}
.iconbtn{width:44px;height:44px;border-radius:22px;border:0;background:var(--bub);color:var(--navy);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.iconbtn:disabled{background:#fff;color:#B9C4CF;cursor:default}
.legend{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;font-size:12px;color:#4A5A6B}
.legend span{display:flex;align-items:center;gap:5px}.legend i{width:8px;height:8px;border-radius:4px}
.slots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
@media(min-width:420px){.slots{grid-template-columns:repeat(3,minmax(0,1fr))}}
.slot{min-height:56px;border-radius:12px;font-weight:800;font-size:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;border:1.5px solid var(--bub2);background:#fff;color:var(--navy);padding:4px}
.slot small{font-size:12px;font-weight:700}
.slot.sel{background:var(--navy);border-color:var(--navy);color:#fff}
.slot.short{border-style:dashed;border-color:var(--line2);color:#7A8794;cursor:default}
.slot.taken{border-color:transparent;background:#F1F4F7;color:#8996A3;cursor:default}
.nav{position:sticky;bottom:0;display:flex;justify-content:space-around;border-top:1px solid var(--line);background:#fff;padding:6px 6px calc(8px + env(safe-area-inset-bottom));z-index:5}
.nav a{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:64px;padding:6px;font-size:12px;font-weight:700;color:var(--muted);text-decoration:none}
.nav a.on{color:var(--navy);font-weight:800}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 20px 0}
.top .word{width:150px;height:auto}
.hello{display:flex;align-items:center;gap:8px;padding:4px 12px 4px 4px;border-radius:22px;background:var(--bub);font-weight:800;font-size:14px;color:var(--navy);text-decoration:none}
.hello .av{width:32px;height:32px;font-size:13px;background:#fff}
.hero{width:220px;height:auto;margin:0 auto}
.wordbig{width:250px;height:auto;margin:0 auto}
.photo{width:104px;height:104px;border-radius:50%;object-fit:cover;border:3px solid var(--bub2);background:var(--bub);display:flex;align-items:center;justify-content:center;color:var(--navy);flex-shrink:0}
.filebtn{position:relative;overflow:hidden}
.filebtn input{position:absolute;inset:0;opacity:0;cursor:pointer;font-size:0}
.thumbs{display:flex;gap:10px;flex-wrap:wrap}
.thumb{position:relative;width:72px;height:72px;border-radius:12px;overflow:hidden;background:var(--bub)}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb button{position:absolute;top:3px;right:3px;width:26px;height:26px;border-radius:13px;border:0;background:rgba(30,42,56,.8);color:#fff;cursor:pointer;font-size:16px;line-height:1;padding:0}
.addthumb{width:72px;height:72px;border-radius:12px;border:2px dashed var(--bub2);background:#fff;display:flex;align-items:center;justify-content:center;color:var(--navy);cursor:pointer}
.err{color:var(--bad);font-size:14px;font-weight:700}
.err:empty{display:none}
.tabs{display:flex;padding:4px;border-radius:14px;background:#E6EEF6;gap:2px;overflow-x:auto}
.tabs button{flex:1;min-height:42px;border:0;border-radius:10px;background:transparent;font-weight:700;font-size:14px;color:#4A5A6B;cursor:pointer;padding:0 12px;white-space:nowrap}
.tabs button.on{background:#fff;color:var(--navy);font-weight:800}
.kv{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px;font-size:14px}
.kv div span,.lbl{display:block;color:var(--muted);font-size:12px;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
.datetile{width:52px;height:52px;border-radius:14px;background:var(--bub);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--navy);flex-shrink:0}
.datetile small{font-size:11px;font-weight:800}.datetile b{font-size:20px;line-height:1}
.note{font-size:14px;color:#4A5A6B;padding:10px 12px;border-radius:10px;background:#F6F9FC}
.info{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:14px;background:var(--bub);font-size:14px;color:var(--navy)}
.empty{text-align:center;padding:24px 12px;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:12px}
.empty img{width:150px;height:auto}
.hint{font-size:12px;color:var(--muted);text-align:center;padding:10px;border-radius:12px;border:1px dashed var(--line2)}
/* admin */
.adm{display:flex;flex-direction:column;min-height:calc(100vh - 34px)}
.side{background:var(--navy-d);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.side .logo{background:#fff;border-radius:12px;padding:8px 10px;display:flex}
.side .logo img{width:120px;height:auto}
.side nav{display:flex;gap:4px;flex-wrap:wrap;flex:1}
.side nav a{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:12px;color:#DCE7F1;text-decoration:none;font-weight:700;font-size:15px}
.side nav a.on{background:var(--navy);color:#fff;font-weight:800}
.badge{min-width:22px;height:22px;border-radius:11px;background:#F2C9A8;color:#5A2E14;font-size:12px;display:inline-flex;align-items:center;justify-content:center;padding:0 6px}
.side .out{color:#BFD0E0;font-size:14px;text-decoration:none;padding:8px}
.side .lbl2{display:none;font-size:11px;font-weight:800;letter-spacing:2px;color:#9FB5CC;padding:0 12px}
.main{flex:1;padding:20px 16px 48px;display:flex;flex-direction:column;gap:20px;min-width:0}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:14px}
.head h1{font-size:30px}
.side .sp{display:none}
@media(min-width:768px){
.adm{flex-direction:row}
.side{width:240px;flex-direction:column;align-items:stretch;padding:24px 16px;gap:16px;flex-shrink:0;position:sticky;top:0;height:100vh}
.side .logo{justify-content:center;padding:14px}
.side .logo img{width:170px}
.side nav{flex-direction:column;flex:0}
.side nav a{justify-content:flex-start}
.side .sp{display:block;flex:1}
.side .lbl2{display:block}
.main{padding:32px}
}
@media(min-width:1200px){.main{padding:36px 48px}}
.cols{display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start}
.cols>.wide{flex:999 1 520px;min-width:0}
.cols>.narrow{flex:1 1 300px;min-width:0}
.req .body{display:flex;flex-wrap:wrap;gap:18px}
.dogpic{width:96px;height:96px;border-radius:16px;object-fit:cover;background:var(--bub);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:30px;color:var(--navy);font-family:'Delius',cursive}
.acts{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end;border-top:1px solid #E6EDF4;padding-top:14px;margin-top:14px}
.scrollx{overflow-x:auto}
.wk{display:grid;grid-template-columns:50px repeat(7,minmax(62px,1fr));gap:5px;min-width:520px}
.wk .h{text-align:center;font-size:12px;font-weight:800;color:var(--muted);padding:2px 0 6px;display:flex;flex-direction:column;align-items:center;gap:2px}
.wk .h b{font-size:18px;color:var(--navy)}
.wk .h button{border:0;background:var(--bub);color:var(--navy);font-size:11px;font-weight:800;border-radius:8px;padding:3px 6px;cursor:pointer}
.wk .t{font-size:13px;font-weight:800;color:var(--muted);display:flex;align-items:center}
.cell{height:40px;border-radius:8px;font-size:12px;font-weight:800;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 4px;cursor:pointer;border:0}
.c-open{border:1.5px solid #9FD3B2;background:#EAF7EF;color:var(--okt)}
.c-closed{background:#E3E8ED;color:#6E7C89}
.c-booked{background:var(--navy);color:#fff;cursor:default}
.c-pending{background:#F7DDB3;color:#6B4100;cursor:default}
.c-past{opacity:.45;cursor:default}
.hrow{display:flex;align-items:center;gap:8px;font-size:14px;flex-wrap:wrap}
.hrow select{height:40px;border:1.5px solid var(--line2);border-radius:10px;padding:0 6px;font:inherit;font-size:14px;background:#fff}
.hrow .d{width:54px;font-weight:800}
.rule{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:14px;font-weight:700}
.rule select{height:40px;border:1.5px solid var(--line2);border-radius:10px;padding:0 8px;font:inherit;font-size:14px;background:#fff}
.tbl{border-radius:18px;background:#fff;border:1px solid #E1E9F1;overflow-x:auto}
.tbl .in{min-width:560px}
.tr{display:grid;grid-template-columns:2fr 1.2fr .6fr .9fr;gap:12px;align-items:center;padding:12px 16px;border:0;border-bottom:1px solid #EEF2F6;width:100%;background:#fff;font:inherit;text-align:left;color:var(--ink);cursor:pointer}
.tr.th{font-size:12px;font-weight:800;letter-spacing:1px;color:var(--muted);cursor:default}
.tr.on{background:var(--bub)}
.tr .nm{display:flex;align-items:center;gap:12px;min-width:0}
.tr .nm span{display:flex;flex-direction:column;min-width:0}
.tr .nm em{font-style:normal;font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.search{display:flex;align-items:center;gap:8px;height:46px;padding:0 14px;border:1.5px solid var(--line2);border-radius:23px;background:#fff;min-width:240px;flex:0 1 320px}
.search input{border:0;outline:none;font:inherit;font-size:15px;flex:1;background:transparent;min-width:0}
.svrow{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start;padding-bottom:12px;border-bottom:1px solid #EEF2F6}
.mini{display:flex;flex-direction:column;gap:8px}
.mini .it{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:14px;padding:10px 12px;border-radius:10px;background:#F6F9FC}
#modal{position:fixed;inset:0;background:rgba(20,30,45,.5);display:flex;align-items:flex-end;justify-content:center;z-index:50}
#modal[hidden]{display:none}
.sheet{background:#fff;width:100%;max-width:480px;border-radius:22px 22px 0 0;padding:22px 20px calc(22px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:14px;max-height:90vh;overflow:auto}
@media(min-width:768px){#modal{align-items:center}.sheet{border-radius:22px}}
#toast{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom));transform:translate(-50%,16px);background:var(--ink);color:#fff;padding:12px 18px;border-radius:14px;font-size:14px;font-weight:700;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none;max-width:90vw;width:max-content;z-index:60;text-align:center}
#toast.show{opacity:1;transform:translate(-50%,0)}
.demo-hint{font-size:13px;color:var(--muted);text-align:center;padding:10px;border-radius:12px;background:var(--bub)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
