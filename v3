    '<div class="row"><button class="iconbtn" style="background:#fff;border:1.5px solid var(--line2)" data-act="wk" data-d="-1" aria-label="Previous week">' + IC.back + '</button><b style="color:var(--navy);min-width:150px;text-align:center">' + fmtDay(days[0]) + ' – ' + fmtDay(days[6]) + '</b><button class="iconbtn" style="background:#fff;border:1.5px solid var(--line2)" data-act="wk" data-d="1" aria-label="Next week">' + IC.next + '</button>' + (off ? '<button class="link" data-act="wk" data-d="0">This week</button>' : '') + '</div></div>' +
